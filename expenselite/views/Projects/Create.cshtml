@model CreateProjectForm

@{
    ViewData["Title"] = "新增專案";
}

<div class="el-page el-page--form">
    <a asp-action="Index">← 返回列表</a>
    <h1 class="el-title el-title--form">新增專案</h1>

    <form asp-action="Create" method="post" class="el-fields">
        <div asp-validation-summary="ModelOnly" class="el-error"></div>

        <div class="field">
            <label asp-for="Name">專案名稱</label>
            <input asp-for="Name" class="input" autocomplete="off" />
            <span asp-validation-for="Name" class="el-error"></span>
        </div>

        <div class="field">
            <label asp-for="CustomerName">客戶名稱</label>
            <input asp-for="CustomerName" class="input" autocomplete="off" />
            <span asp-validation-for="CustomerName" class="el-error"></span>
        </div>

        <div class="el-actions">
            <button type="submit" class="btn btn-primary">建立</button>
            <a class="btn btn-secondary" asp-action="Index">取消</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
