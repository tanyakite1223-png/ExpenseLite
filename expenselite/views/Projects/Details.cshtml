@model ProjectDetailDto

@{
    ViewData["Title"] = "專案詳情";
}

<div class="el-page">
    <a asp-action="Index">← 返回專案列表</a>

    <div class="el-head">
        <div>
            <div class="el-status-line">
                <span class="tag el-status @(Model.Status == ProjectStatus.Active ? "el-status--submitted" : "el-status--cancelled")">@ProjectStatusText(Model.Status)</span>
                <span class="el-hint">建立於 @Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</span>
            </div>
            <h1 class="el-title">@Model.Name</h1>
            <div class="el-meta">
                <span>客戶：@Model.CustomerName</span>
            </div>
        </div>
    </div>

    @* 原本是四個框線圓角方塊。設計系統不用框線切版，改成留白分隔。
       建立時間不是「數量」，所以不放大成大字。 *@
    <div class="el-stats">
        <div class="el-stat">
            <span class="el-stat-label">報銷單總數</span>
            <span class="el-stat-value">@Model.ExpenseReports.Count</span>
        </div>
        <div class="el-stat">
            <span class="el-stat-label">未完成</span>
            <span class="el-stat-value @(Model.UnfinishedExpenseReportCount > 0 ? "el-due" : "")">@Model.UnfinishedExpenseReportCount</span>
        </div>
        <div class="el-stat">
            <span class="el-stat-label">已核准金額</span>
            <span class="el-stat-value">@Model.ExpenseReports.Where(x => x.Status == ExpenseReportStatus.Approved).Sum(x => x.TotalAmount).ToString("N0")</span>
        </div>
    </div>

    @if (Model.Status == ProjectStatus.Active && Model.UnfinishedExpenseReportCount > 0)
    {
        <div class="el-notice el-notice--quiet">
            還有 @Model.UnfinishedExpenseReportCount 張報銷單在流程中，要等它們走完才能結案。
        </div>
    }

    <h2 class="el-kicker el-kicker--section">相關報銷單</h2>

    @if (Model.ExpenseReports.Count == 0)
    {
        <div class="el-notice el-notice--quiet">這個專案目前沒有相關報銷單。</div>
    }
    else
    {
        <table class="table el-table el-table--project-reports">
            <thead>
                <tr>
                    <th>標題</th>
                    <th>申請人</th>
                    <th>付款方式</th>
                    <th>狀態</th>
                    <th>總金額</th>
                    <th>建立</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var report in Model.ExpenseReports)
            {
                <tr>
                    <td class="strong">@report.Title</td>
                    <td class="nowrap">@report.ApplicantName</td>
                    <td>@PaymentMethodText(report.PaymentMethod)</td>
                    <td><span class="tag el-status @StatusClass(report.Status)">@ReportStatusText(report.Status)</span></td>
                    <td class="num">@report.TotalAmount.ToString("N2")</td>
                    <td class="nowrap el-readonly">@report.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</td>
                    <td>
                        <div class="el-cell-actions">
                            <a class="btn btn-ghost"
                               asp-controller="ExpenseReports"
                               asp-action="Details"
                               asp-route-id="@report.Id">檢視</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

@functions {
    // 青＝流程順利，洋紅＝需要注意，灰＝不在流程中。跟報銷單列表同一套。
    private static string StatusClass(ExpenseReportStatus status) => status switch
    {
        ExpenseReportStatus.Draft => "el-status--draft",
        ExpenseReportStatus.Submitted => "el-status--submitted",
        ExpenseReportStatus.Returned => "el-status--returned",
        ExpenseReportStatus.Approved => "el-status--approved",
        ExpenseReportStatus.Rejected => "el-status--rejected",
        ExpenseReportStatus.Voided => "el-status--voided",
        ExpenseReportStatus.Cancelled => "el-status--cancelled",
        _ => "el-status--cancelled"
    };

    @* ProjectStatusText / ReportStatusText / PaymentMethodText 沿用原檔，未改動。 *@
}
