@model ProjectListPageDto

@{
    ViewData["Title"] = "專案";
    var isManager = User.IsManager();
}

<div class="el-page">
    <div class="el-head">
        <div>
            <h1 class="el-title">專案</h1>
            <p class="el-sub">專案支出報銷單會連到這裡的專案資料</p>
        </div>
        @if (isManager)
        {
            <div class="el-actions">
                <a class="btn btn-primary" asp-action="Create">新增專案</a>
            </div>
        }
    </div>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="el-notice el-notice--warn">@errorMessage</div>
    }
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="el-notice">@successMessage</div>
    }

    <form asp-action="Index" method="get" class="el-filters el-filters--inline">
        <div class="field field--grow">
            <label for="keyword">關鍵字</label>
            <input type="search" id="keyword" name="keyword" value="@Model.Keyword" class="input" placeholder="搜尋專案名稱、客戶、狀態" />
        </div>
        <div class="el-actions">
            <button type="submit" class="btn btn-secondary">搜尋</button>
            @if (!string.IsNullOrWhiteSpace(Model.Keyword))
            {
                <a class="btn btn-ghost" asp-action="Index">清除</a>
            }
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Keyword))
    {
        <div class="el-count">找到 @Model.Projects.Count 筆符合「@Model.Keyword」的專案</div>
    }

    @if (Model.Projects.Count == 0)
    {
        <div class="el-notice el-notice--quiet">@EmptyProjectMessage(Model)</div>
    }
    else
    {
        <table class="table el-table el-table--projects">
            <thead>
                <tr>
                    <th>專案名稱</th>
                    <th>客戶</th>
                    <th>狀態</th>
                    <th class="count">未完成報銷單</th>
                    <th>建立</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var project in Model.Projects)
            {
                <tr>
                    <td class="strong">@project.Name</td>
                    <td>@project.CustomerName</td>
                    <td><span class="tag el-status @(project.Status == ProjectStatus.Active ? "el-status--submitted" : "el-status--cancelled")">@StatusText(project.Status)</span></td>
                    <td class="count">@project.UnfinishedExpenseReportCount</td>
                    <td class="nowrap el-readonly">@project.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</td>
                    <td>
                        <div class="el-cell-actions">
                            <a class="btn btn-ghost" asp-action="Details" asp-route-id="@project.Id">檢視</a>
                            @* 有未完成報銷單時不畫結案按鈕——點下去一定失敗。 *@
                            @if (isManager && project.Status == ProjectStatus.Active && project.UnfinishedExpenseReportCount == 0)
                            {
                                <form asp-action="Close" asp-route-id="@project.Id" method="post"
                                      onsubmit="return confirm('確定要將這個專案結案嗎？結案後不可再新增該專案支出報銷單。');">
                                    <button type="submit" class="btn btn-ghost">結案</button>
                                </form>
                            }
                            else if (isManager && project.Status == ProjectStatus.Active)
                            {
                                <span class="el-cell-note">有未完成報銷單</span>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

@functions {
    @* StatusText / EmptyProjectMessage 沿用原檔，未改動。 *@
}
