@model ErrorViewModel
@{
    ViewData["Title"] = "發生錯誤";
}

@* 原檔是 ASP.NET 樣板留下來的英文開發說明，對使用者沒有意義。
   改成一句人話 + 給工程師的 Request ID。 *@
<div class="el-page">
    <h1 class="el-title">這個操作沒有完成</h1>
    <p class="el-lede el-lede--single">系統在處理你的請求時出錯了。剛才的操作可能沒有存檔，回上一頁重試一次。若一直失敗，把下面的代碼給工程師。</p>

    @if (Model.ShowRequestId)
    {
        <dl class="el-facts">
            <dt>錯誤代碼</dt>
            <dd class="num">@Model.RequestId</dd>
        </dl>
    }

    <div class="el-actions">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">回首頁</a>
    </div>
</div>
