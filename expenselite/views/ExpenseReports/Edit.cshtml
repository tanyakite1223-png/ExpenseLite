@model EditExpenseReportForm

@{
    ViewData["Title"] = "修改報銷單";
}

<div class="el-page el-page--narrow">
    <a asp-action="Details" asp-route-id="@Model.Id">← 返回報銷單</a>
    <h1 class="el-title el-title--form">修改報銷單</h1>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="el-fields">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="el-error"></div>

        <div class="field">
            <label asp-for="Title">標題</label>
            <input asp-for="Title" class="input" autocomplete="off" />
            <span asp-validation-for="Title" class="el-error"></span>
        </div>

        <div class="field">
            <label>申請人</label>
            <input class="input el-readonly" value="@Model.ApplicantName" readonly />
            <div class="el-hint">申請人是建立這張報銷單的人，不可修改。</div>
        </div>

        <div class="field">
            <label asp-for="ExpenseType">支出類型</label>
            <select asp-for="ExpenseType" class="input">
                <option value="@ExpenseType.General">一般支出</option>
                <option value="@ExpenseType.Project">專案支出</option>
            </select>
            <span asp-validation-for="ExpenseType" class="el-error"></span>
        </div>

        <div class="field">
            <label asp-for="ProjectId">專案</label>
            <select asp-for="ProjectId" class="input">
                <option value="">不連到專案</option>
                @foreach (var project in Model.ProjectOptions)
                {
                    <option value="@project.Id">@project.Name - @project.CustomerName</option>
                }
            </select>
            <div class="el-hint">只有支出類型為專案支出時需要選擇。</div>
            <span asp-validation-for="ProjectId" class="el-error"></span>
        </div>

        <div class="field">
            <label asp-for="PaymentMethod">付款方式</label>
            <select asp-for="PaymentMethod" class="input">
                <option value="@ExpensePaymentMethod.EmployeePaid">員工墊款</option>
                <option value="@ExpensePaymentMethod.PersonalAdvance">個人預支</option>
                <option value="@ExpensePaymentMethod.PettyCash">零用金支付</option>
            </select>
            <div class="el-hint">
                這筆錢從哪來：員工墊款是你自己先付、公司要還你；個人預支是用公司先給你的錢；零用金支付是從抽屜拿現金付的，公司不用再付你。
            </div>
            <span asp-validation-for="PaymentMethod" class="el-error"></span>
        </div>

        <div class="field">
            <label asp-for="CashAdvanceId">對應預支款</label>
            <select asp-for="CashAdvanceId" class="input">
                <option value="">不使用預支款</option>
                @foreach (var cashAdvance in Model.CashAdvanceOptions)
                {
                    <option value="@cashAdvance.Id">
                        @cashAdvance.AdvancedAt.ToString("yyyy/MM/dd")．@cashAdvance.PayeeName．@cashAdvance.Purpose．@cashAdvance.Amount.ToString("N2")
                    </option>
                }
            </select>
            <div class="el-hint">只有付款方式為個人預支時需要選擇，這裡只會列出領給你自己的預支款。</div>
            <span asp-validation-for="CashAdvanceId" class="el-error"></span>
        </div>

        <div class="el-actions">
            <button type="submit" class="btn btn-primary">儲存</button>
            <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Id">取消</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
