@model CashAdvanceListPageDto

@{
    ViewData["Title"] = "預支款";
    var isManager = User.IsManager();
}

<div class="el-page">
    <div class="el-head">
        <div>
            <h1 class="el-title">預支款</h1>
            <p class="el-sub">@(isManager ? "追蹤預支款、已核准報銷與實際結清狀態" : "你領到的預支款與零用金的使用狀態")</p>
        </div>
        @if (isManager)
        {
            <div class="el-actions">
                <a class="btn btn-primary" asp-action="Create">新增預支款</a>
            </div>
        }
    </div>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="el-notice el-notice--warn">@errorMessage</div>
    }
    @if (TempData["WarningMessage"] is string warningMessage)
    {
        <div class="el-notice el-notice--warn">@warningMessage</div>
    }
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="el-notice">@successMessage</div>
    }

    <form asp-action="Index" method="get" class="el-filters">
        <div class="field field--grow">
            <label for="keyword">關鍵字</label>
            <input type="search" id="keyword" name="keyword" value="@Model.Keyword" class="input" placeholder="搜尋領款人、用途" />
        </div>
        <div class="field field--md">
            <label for="reconciliationStatus">核對狀態</label>
            <select id="reconciliationStatus" name="reconciliationStatus" class="input">
                <option value="">全部</option>
                <option value="@CashAdvanceReconciliationStatus.Unreimbursed" selected="@(Model.ReconciliationStatus == CashAdvanceReconciliationStatus.Unreimbursed)">未結清</option>
                <option value="@CashAdvanceReconciliationStatus.Settled" selected="@(Model.ReconciliationStatus == CashAdvanceReconciliationStatus.Settled)">已結清</option>
                <option value="@CashAdvanceReconciliationStatus.CompanyNeedsToPay" selected="@(Model.ReconciliationStatus == CashAdvanceReconciliationStatus.CompanyNeedsToPay)">公司需補付</option>
                <option value="@CashAdvanceReconciliationStatus.EmployeeNeedsToReturn" selected="@(Model.ReconciliationStatus == CashAdvanceReconciliationStatus.EmployeeNeedsToReturn)">員工需繳回</option>
            </select>
        </div>
        <div class="el-actions">
            <button type="submit" class="btn btn-secondary">篩選</button>
            @if (HasFilter(Model))
            {
                <a class="btn btn-ghost" asp-action="Index">清除</a>
            }
        </div>
    </form>

    @if (HasFilter(Model))
    {
        <div class="el-count">找到 @Model.CashAdvances.Count 筆符合篩選的預支款</div>
    }

    @if (Model.CashAdvances.Count == 0)
    {
        <div class="el-notice el-notice--quiet">@EmptyCashAdvanceMessage(Model, isManager)</div>
    }
    else
    {
        @* 原本把預支金額／已核准報銷／差額／結清方向／已結清／尚待結清六欄全攤在列表上，
           讀者得自己拼出那個減法。中間步驟留給詳情頁的帳本，列表只回答
           「預支多少」與「還要怎麼結、還差多少」。 *@
        <table class="table el-table el-table--advances">
            <thead>
                <tr>
                    <th>預支日期</th>
                    <th>領款人</th>
                    <th>用途</th>
                    <th>預支金額</th>
                    <th>還要怎麼結</th>
                    <th>核對狀態</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var cashAdvance in Model.CashAdvances)
            {
                <tr>
                    <td class="nowrap">@cashAdvance.AdvancedAt.ToString("yyyy/MM/dd")</td>
                    <td class="nowrap">@cashAdvance.PayeeName</td>
                    <td>@cashAdvance.Purpose</td>
                    <td class="num">@cashAdvance.Amount.ToString("N2")</td>
                    <td>
                        @if (cashAdvance.RemainingSettlementAmount > 0m)
                        {
                            <div>@DirectionText(cashAdvance.RequiredSettlementType)</div>
                            <div class="el-cell-sub el-cell-sub--warn">@cashAdvance.RemainingSettlementAmount.ToString("N2")</div>
                        }
                        else
                        {
                            <span class="el-readonly">不用再結</span>
                        }
                    </td>
                    <td>
                        <span class="tag el-status @ReconClass(cashAdvance.ReconciliationStatus)">@ReconciliationText(cashAdvance)</span>
                        @if (cashAdvance.HasInProgressReports)
                        {
                            <div class="el-cell-sub">數字為暫估</div>
                        }
                    </td>
                    <td>
                        <div class="el-cell-actions">
                            <a class="btn btn-ghost" asp-action="Details" asp-route-id="@cashAdvance.Id">@ActionText(cashAdvance, isManager)</a>
                            @if (isManager)
                            {
                                <a class="btn btn-ghost" asp-action="Edit" asp-route-id="@cashAdvance.Id">修改</a>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

@functions {
    // 已結清＝青（流程順利），需補付／需繳回＝洋紅（需要注意），未結清＝外框。
    private static string ReconClass(CashAdvanceReconciliationStatus status) => status switch
    {
        CashAdvanceReconciliationStatus.Settled => "el-recon--settled",
        CashAdvanceReconciliationStatus.CompanyNeedsToPay => "el-recon--pending",
        CashAdvanceReconciliationStatus.EmployeeNeedsToReturn => "el-recon--pending",
        CashAdvanceReconciliationStatus.Unreimbursed => "el-recon--unreimbursed",
        _ => "el-recon--unreimbursed"
    };

    // 用「誰要做什麼」說話，跟詳情頁的帳本同一套詞。
    private static string DirectionText(CashAdvanceSettlementType? settlementType)
        => settlementType switch
        {
            CashAdvanceSettlementType.CompanyPaid => "公司要補付",
            CashAdvanceSettlementType.EmployeeReturned => "員工要繳回",
            _ => "—"
        };

    @* 以下 ReconciliationText / ActionText / HasFilter / EmptyCashAdvanceMessage
       沿用原檔，未改動。原本的 SettlementTypeText 已被 DirectionText 取代。 *@
}
