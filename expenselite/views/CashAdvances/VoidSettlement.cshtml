@model VoidCashAdvanceSettlementPage

@{
    ViewData["Title"] = "不採用此筆結清紀錄";
}

<div class="el-page el-page--form">
    <a asp-action="Details" asp-route-id="@Model.CashAdvance.Id">← 返回預支款詳情</a>
    <h1 class="el-title el-title--form">不採用此筆結清紀錄</h1>

    <div class="el-notice el-notice--warn">
        此動作只影響這筆結清紀錄，不影響預支款與報銷單。標記為不採用後，這筆紀錄不再計入已結清金額，但仍會保留在詳情頁歷史中。
    </div>

    @* 要不採用的是哪一筆，攤在動作前面讓人核對。 *@
    <dl class="el-facts">
        <dt>領款人</dt>
        <dd>@Model.CashAdvance.PayeeName</dd>
        <dt>用途</dt>
        <dd>@Model.CashAdvance.Purpose</dd>
        <dt>結清日期</dt>
        <dd>@Model.SettlementRecord.SettledAt.ToString("yyyy/MM/dd")</dd>
        <dt>方向與金額</dt>
        <dd><span class="pair">@SettlementTypeText(Model.SettlementRecord.SettlementType)<span class="num">@Model.SettlementRecord.Amount.ToString("N2")</span></span></dd>
        <dt>處理人</dt>
        <dd>@Model.SettlementRecord.HandledBy</dd>
        <dt>備註</dt>
        <dd>@DisplayNote(Model.SettlementRecord.Note)</dd>
    </dl>

    <form asp-action="VoidSettlement"
          asp-route-id="@Model.CashAdvance.Id"
          asp-route-settlementRecordId="@Model.SettlementRecord.Id"
          method="post" class="el-fields el-fields--inline">
        <div asp-validation-summary="ModelOnly" class="el-error"></div>
        <input asp-for="Settlement.CashAdvanceId" type="hidden" />
        <input asp-for="Settlement.SettlementRecordId" type="hidden" />

        <div class="field">
            <label>不採用處理人</label>
            <input class="input el-readonly" value="@User.GetDisplayName()" readonly />
            <div class="el-hint">處理人就是目前登入的人。</div>
        </div>

        <div class="field">
            <label asp-for="Settlement.VoidReason">不採用原因</label>
            <textarea asp-for="Settlement.VoidReason" class="input el-desc" rows="3"
                      placeholder="會保留在詳情頁歷史裡，日後查得到當時為什麼撤掉這筆"></textarea>
            <span asp-validation-for="Settlement.VoidReason" class="el-error"></span>
        </div>

        <div class="el-actions">
            <button type="submit" class="btn btn-danger">確認不採用</button>
            <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.CashAdvance.Id">取消</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@functions {
    @* SettlementTypeText 與 DisplayNote 沿用原檔，未改動。 *@
}
