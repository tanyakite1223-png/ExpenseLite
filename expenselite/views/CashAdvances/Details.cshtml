@model CashAdvanceSettlementPage

@{
    ViewData["Title"] = $"{Model.CashAdvance.PayeeName} 預支款";
    // 領款人本人看得到這一頁（自己那筆錢的使用狀態），但結清作業仍然只有主管能做。
    // 這幾行只決定按鈕畫不畫，真正的把關在 Controller 的 [Authorize] 與 Application Service。
    var isManager = User.IsManager();
    var advance = Model.CashAdvance;
    var direction = advance.RequiredSettlementType;
    var isSettled = advance.ReconciliationStatus == CashAdvanceReconciliationStatus.Settled;
    var canRecord = isManager && !isSettled && !advance.HasInProgressReports && advance.RemainingSettlementAmount > 0m;
}

<div class="el-page">
    <a asp-action="Index">← 返回預支款列表</a>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="el-notice el-notice--warn">@errorMessage</div>
    }
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="el-notice">@successMessage</div>
    }

    <div class="el-head">
        <div>
            <div class="el-status-line">
                <span class="tag el-status @ReconClass(advance.ReconciliationStatus)">@ReconciliationText(advance.ReconciliationStatus)</span>
                <span class="el-hint">預支日期 @advance.AdvancedAt.ToString("yyyy/MM/dd")</span>
            </div>
            <h1 class="el-title">@advance.PayeeName</h1>
            <div class="el-meta">
                <span>用途：@advance.Purpose</span>
            </div>
        </div>
        <div>
            <div class="el-kicker">預支金額</div>
            <div class="el-total el-total--sm">@advance.Amount.ToString("N2")</div>
            @if (isManager)
            {
                <div class="el-actions el-actions--end">
                    @if (advance.CanEdit)
                    {
                        <a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@advance.Id">修改預支款</a>
                    }
                    else
                    {
                        <span class="el-hint">已結清後鎖定</span>
                    }
                </div>
            }
        </div>
    </div>

    <div class="el-split el-split--wide-rail">
        <div>
            @* 核對算式攤成直式帳本：差額 = 已核准報銷 − 預支金額，結論用方向明說，
               不讓閱讀者自己判斷正負號。 *@
            <h2 class="el-kicker">核對算式</h2>
            <div class="el-ledger">
                <div class="el-ledger-row">
                    <span class="el-ledger-label">預支給 @advance.PayeeName</span>
                    <span class="el-ledger-num">@advance.Amount.ToString("N2")</span>
                </div>
                <div class="el-ledger-row">
                    <span class="el-ledger-label">已核准報銷</span>
                    <span class="el-ledger-num">− @advance.ApprovedReimbursedAmount.ToString("N2")</span>
                </div>
                <div class="el-ledger-rule"></div>

                @if (direction is null)
                {
                    <div class="el-ledger-row el-ledger-row--total">
                        <span class="el-ledger-label">兩邊剛好平</span>
                        <span class="el-ledger-num">0.00</span>
                    </div>
                    <div class="el-ledger-note">報銷金額正好等於預支金額，不需要任何結清動作。</div>
                }
                else
                {
                    <div class="el-ledger-row el-ledger-row--total">
                        <span class="el-ledger-label">@DirectionText(direction)</span>
                        <span class="el-ledger-num">@advance.RequiredSettlementAmount.ToString("N2")</span>
                    </div>

                    @if (advance.SettledAmount > 0m)
                    {
                        <div class="el-ledger-nested">
                            <div class="el-ledger-row">
                                <span class="el-ledger-label">@DoneText(direction)</span>
                                <span class="el-ledger-num">− @advance.SettledAmount.ToString("N2")</span>
                            </div>
                            <div class="el-ledger-rule"></div>
                            <div class="el-ledger-row el-ledger-row--left">
                                <span class="el-ledger-label">@LeftText(direction)</span>
                                <span class="el-ledger-num">@advance.RemainingSettlementAmount.ToString("N2")</span>
                            </div>
                        </div>
                    }
                }
            </div>

            @if (advance.HasInProgressReports)
            {
                <div class="el-notice el-notice--warn">
                    這筆預支款仍有流程中的報銷單，上面的數字只是暫估。請等相關報銷單核准或拒絕後再做最終結清。
                </div>
            }

            @* 作廢後的持續提示：核對金額即時反映了作廢，但下方的結清紀錄不會自動動。 *@
            @if (advance.VoidedRelatedReportCount > 0)
            {
                <div class="el-notice el-notice--warn">
                    <strong>這筆預支款有 @advance.VoidedRelatedReportCount 張已被作廢的報銷單。</strong>
                    「已核准報銷」金額已即時扣掉那幾張單，但下方已計入的結清紀錄不會自動動——
                    @if (advance.CanEdit)
                    {
                        <text>若那筆錢實際上要退回或方向反了，請自行標記相關結清紀錄為不採用，或再補一筆反向結清。</text>
                    }
                    else
                    {
                        <text>這筆預支款已結清並鎖定；若日後要處理這類更正，需要另外開正式更正流程。</text>
                    }
                </div>
            }

            @* 每筆紀錄的資訊量不對稱（不採用的要多帶三行說明），所以不用表格。 *@
            <h2 class="el-kicker el-kicker--section">結清紀錄</h2>
            @if (advance.SettlementRecords.Count == 0)
            {
                <div class="el-notice el-notice--quiet">尚無結清紀錄。</div>
            }
            else
            {
                <div class="el-settle">
                @foreach (var record in advance.SettlementRecords)
                {
                    <div class="el-settle-row @(record.IsVoided ? "el-settle-row--voided" : "")">
                        <div class="el-settle-at">@record.SettledAt.ToString("yyyy/MM/dd")</div>
                        <div>
                            <div class="el-settle-type">@SettlementTypeText(record.SettlementType)．@record.HandledBy</div>
                            <div class="el-settle-note">@DisplayNote(record.Note)</div>
                            @if (record.UpdatedAt is not null)
                            {
                                <div class="el-settle-sub">最後修改：@DisplayDateTime(record.UpdatedAt)</div>
                            }
                            @if (record.IsVoided)
                            {
                                <div class="el-settle-sub">
                                    不採用：@record.VoidedBy，@DisplayDateTime(record.VoidedAt)，@record.VoidReason
                                </div>
                            }
                            @if (isManager && (record.CanEdit || record.CanVoid))
                            {
                                <div class="el-settle-actions">
                                    @if (record.CanEdit)
                                    {
                                        <a class="btn btn-ghost"
                                           asp-action="EditSettlement"
                                           asp-route-id="@advance.Id"
                                           asp-route-settlementRecordId="@record.Id">修改</a>
                                    }
                                    @if (record.CanVoid)
                                    {
                                        <a class="btn btn-ghost btn-remove"
                                           asp-action="VoidSettlement"
                                           asp-route-id="@advance.Id"
                                           asp-route-settlementRecordId="@record.Id">不採用</a>
                                    }
                                </div>
                            }
                        </div>
                        <div class="el-settle-figure">
                            <div class="el-settle-amount">@record.Amount.ToString("N2")</div>
                            <div class="el-settle-state">@SettlementRecordStatusText(record)</div>
                        </div>
                    </div>
                }
                </div>
            }
        </div>

        <div class="el-rail">
            @if (direction is not null)
            {
                <div class="el-rail-label">@LeftText(direction)</div>
                @* 還有錢沒收拾就標洋紅，跟帳本裡的「尚待結清」同色。 *@
                <div class="el-total @(advance.RemainingSettlementAmount > 0m ? "el-total--due" : "")">@advance.RemainingSettlementAmount.ToString("N2")</div>
                <div class="el-rail-sep"></div>
            }

            @if (!isManager)
            {
                <div class="el-notice el-notice--quiet">
                    結清作業由主管處理。這頁讓你看自己這筆錢目前的使用狀態——花了多少、還差多少。
                </div>
            }
            else if (advance.HasInProgressReports)
            {
                <div class="el-notice el-notice--warn">仍有報銷單在流程中，暫不開放新增最終結清紀錄。</div>
            }
            else if (canRecord)
            {
                <div class="el-rail-label">新增結清紀錄</div>
                <form asp-action="RecordSettlement" asp-route-id="@advance.Id" method="post" class="el-fields">
                    <div asp-validation-summary="ModelOnly" class="el-error"></div>
                    <input asp-for="Settlement.CashAdvanceId" type="hidden" />

                    @* 方向是算式決定的，不是使用者選的——寫成一句話而不是一個唯讀輸入框。 *@
                    <div class="el-fixed-direction">方向由算式決定：<strong>@DirectionText(direction)</strong></div>

                    <div class="field">
                        <label asp-for="Settlement.SettledAt">結清日期</label>
                        <input asp-for="Settlement.SettledAt" type="date" class="input" />
                        <span asp-validation-for="Settlement.SettledAt" class="el-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Settlement.Amount">結清金額</label>
                        @* 新增時不要預填 0.00 *@
                        <input asp-for="Settlement.Amount" class="input" inputmode="decimal" value="@(Model.Settlement.Amount == 0m ? string.Empty : Model.Settlement.Amount.ToString("0.##"))" />
                        <div class="el-hint">尚待結清 @advance.RemainingSettlementAmount.ToString("N2")，不可超過。</div>
                        <span asp-validation-for="Settlement.Amount" class="el-error"></span>
                    </div>

                    <div class="field">
                        <label>處理人</label>
                        <input class="input el-readonly" value="@User.GetDisplayName()" readonly />
                        <div class="el-hint">處理人就是目前登入的人。</div>
                    </div>

                    <div class="field">
                        <label asp-for="Settlement.Note">備註</label>
                        <textarea asp-for="Settlement.Note" class="input el-desc" rows="3" placeholder="怎麼收的、什麼時候收的"></textarea>
                        <span asp-validation-for="Settlement.Note" class="el-error"></span>
                    </div>

                    <div class="el-actions">
                        <button type="submit" class="btn btn-primary">新增紀錄</button>
                    </div>
                </form>
            }
            else
            {
                <div class="el-notice">這筆預支款已結清，預支款資料與結清紀錄已鎖定。</div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@functions {
    // 已結清＝青（流程順利），需補付／需繳回＝洋紅（需要注意），未結清＝外框。
    private static string ReconClass(CashAdvanceReconciliationStatus status) => status switch
    {
        CashAdvanceReconciliationStatus.Settled => "el-recon--settled",
        CashAdvanceReconciliationStatus.CompanyNeedsToPay => "el-recon--pending",
        CashAdvanceReconciliationStatus.EmployeeNeedsToReturn => "el-recon--pending",
        CashAdvanceReconciliationStatus.Unreimbursed => "el-recon--unreimbursed",
        _ => "el-recon--unreimbursed"
    };

    // 帳本用「誰要做什麼」說話，不用「差額」這種要自己解讀正負號的詞。
    private static string DirectionText(CashAdvanceSettlementType? settlementType)
        => settlementType switch
        {
            CashAdvanceSettlementType.CompanyPaid => "公司要補付",
            CashAdvanceSettlementType.EmployeeReturned => "員工要繳回",
            _ => "兩邊剛好平"
        };

    private static string DoneText(CashAdvanceSettlementType? settlementType)
        => settlementType == CashAdvanceSettlementType.CompanyPaid ? "已補付" : "已繳回";

    private static string LeftText(CashAdvanceSettlementType? settlementType)
        => settlementType == CashAdvanceSettlementType.CompanyPaid ? "尚待補付" : "尚待繳回";

    @* 以下 ReconciliationText / SettlementTypeText / DisplayNote /
       SettlementRecordStatusText / DisplayDateTime 沿用原檔，未改動。
       原本的 SettlementRecordRowClass 可以刪掉，改用 .el-settle-row--voided。 *@
}
