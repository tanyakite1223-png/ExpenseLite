@model EditCashAdvancePage

@{
    ViewData["Title"] = "修改預支款";
}

<div class="el-page el-page--form">
    <a asp-action="Details" asp-route-id="@Model.CashAdvance.Id">← 返回預支款</a>
    <h1 class="el-title el-title--form">修改預支款</h1>

    @* 領款人與預支日期建立後就不能改，放在這裡當脈絡而不是當欄位。 *@
    <dl class="el-facts">
        <dt>領款人</dt>
        <dd>@Model.CashAdvance.PayeeName</dd>
        <dt>預支日期</dt>
        <dd>@Model.CashAdvance.AdvancedAt.ToString("yyyy/MM/dd")</dd>
    </dl>

    @if (!Model.CashAdvance.CanEdit)
    {
        <div asp-validation-summary="ModelOnly" class="el-error"></div>
        <div class="el-notice el-notice--warn">這筆預支款已結清，不可修改。</div>
    }
    else
    {
        <form asp-action="Edit" asp-route-id="@Model.CashAdvance.Id" method="post" class="el-fields">
            <div asp-validation-summary="ModelOnly" class="el-error"></div>
            <input asp-for="CashAdvanceForm.CashAdvanceId" type="hidden" />

            <div class="field">
                <label asp-for="CashAdvanceForm.Purpose">預支用途</label>
                <input asp-for="CashAdvanceForm.Purpose" class="input" autocomplete="off" />
                <span asp-validation-for="CashAdvanceForm.Purpose" class="el-error"></span>
            </div>

            <div class="field">
                <label asp-for="CashAdvanceForm.Amount">預支金額</label>
                <input asp-for="CashAdvanceForm.Amount"
                       class="input @(Model.CashAdvance.CanEditAmount ? "" : "el-readonly")"
                       inputmode="decimal"
                       readonly="@(!Model.CashAdvance.CanEditAmount)" />
                @if (!Model.CashAdvance.CanEditAmount)
                {
                    <div class="el-hint">已有報銷單或已採用結清紀錄時，預支金額不可修改。</div>
                }
                <span asp-validation-for="CashAdvanceForm.Amount" class="el-error"></span>
            </div>

            <div class="el-actions">
                <button type="submit" class="btn btn-primary">儲存</button>
                <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.CashAdvance.Id">取消</a>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
