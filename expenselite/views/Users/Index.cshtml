@model IReadOnlyList<UserAccountDto>

@{
    ViewData["Title"] = "使用者";
    var currentUserId = User.GetUserId();
    var activeDailyManagerCount = (int)(ViewData["ActiveDailyManagerCount"] ?? 0);
}

<div class="el-page">
    <div class="el-head">
        <div>
            <h1 class="el-title">使用者</h1>
            <p class="el-sub">系統裡的帳號全部由主管在這一頁建立與維護。</p>
        </div>
        <div class="el-actions">
            <a class="btn btn-primary" asp-action="Create">新增使用者</a>
        </div>
    </div>

    @* 「日常主管」不含緊急存取帳號——那個帳號的定位就是日常不用，靠它撐日常審核違反設計。
       剩 1 位以下時，他自己送的報銷單會沒有人能審或作廢（審核人 ≠ 申請人），所以平時就提醒補人。 *@
    @if (activeDailyManagerCount <= 1)
    {
        <div class="el-notice el-notice--warn">
            @if (activeDailyManagerCount == 0)
            {
                <strong>目前沒有日常主管。</strong>
                <text>只剩緊急存取帳號能維持系統運作，日常審核與作廢會全數卡住。請盡快把某位員工改為主管，或啟用一位已停用的主管。</text>
            }
            else
            {
                <strong>目前只有 1 位日常主管。</strong>
                <text>若這位主管本人送出報銷單將無人能審核或作廢（審核人不能是申請人）。建議指派第二位主管以維持流程順暢。</text>
            }
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="el-notice el-notice--warn">@errorMessage</div>
    }
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="el-notice">@successMessage</div>
    }

    <table class="table el-table el-table--users">
        <thead>
            <tr>
                <th>姓名</th>
                <th>帳號</th>
                <th>Email</th>
                <th>角色</th>
                <th>狀態</th>
                <th>最後登入</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var account in Model)
        {
            var isSelf = currentUserId == account.UserId;
            <tr>
                <td>
                    <span class="el-name">
                        <span class="strong">@account.DisplayName</span>
                        @if (isSelf)
                        {
                            <span class="el-flag el-flag--self">你自己</span>
                        }
                        @if (account.IsProtected)
                        {
                            <span class="el-flag el-flag--protected">緊急存取帳號</span>
                        }
                    </span>
                </td>
                <td class="nowrap">@account.UserName</td>
                <td class="el-readonly">@account.Email</td>
                <td class="nowrap">@ExpenseLiteRoles.GetDisplayName(account.Role)</td>
                <td><span class="tag el-status @StatusClass(account.Status)">@StatusText(account.Status)</span></td>
                @* 緊急存取帳號平常不該有登入紀錄，所以它那格不要淡化，要看得見。 *@
                <td class="nowrap @(account.IsProtected ? "strong" : "el-readonly")">@LastSignInText(account.LastSignedInAt)</td>
                <td>
                    <div class="el-cell-actions">
                        @if (account.IsProtected)
                        {
                            <span class="el-cell-note">不可停用／降級</span>
                        }
                        else if (isSelf)
                        {
                            @* 停用自己與把自己降成員工都沒有正當使用情境（誤按代價高：cookie 失效後得請另一位主管救）。
                               真正的把關在 UserAccountAppService，這裡只是不畫出點得下去卻一定失敗的按鈕。 *@
                            <span class="el-cell-note">不能停用／降級自己</span>
                        }
                        else if (account.Status == UserAccountStatus.Active)
                        {
                            <form asp-action="Disable" asp-route-id="@account.UserId" method="post"
                                  onsubmit="return confirm('確定要停用 @account.DisplayName 的帳號嗎？停用後將無法登入，既有的報銷紀錄不受影響。');">
                                <button type="submit" class="btn btn-ghost">停用</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Activate" asp-route-id="@account.UserId" method="post">
                                <button type="submit" class="btn btn-ghost">啟用</button>
                            </form>
                        }

                        @if (account.IsProtected || isSelf)
                        {
                            @* 受保護帳號與自己的那一列都不畫改角色按鈕，理由同前。 *@
                        }
                        else if (account.Role == ExpenseLiteRoles.Manager)
                        {
                            <form asp-action="SetRole" asp-route-id="@account.UserId" method="post"
                                  onsubmit="return confirm('確定要把 @account.DisplayName 改成員工嗎？他將無法再核准報銷單。');">
                                <input type="hidden" name="role" value="@ExpenseLiteRoles.Employee" />
                                <button type="submit" class="btn btn-ghost">改為員工</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="SetRole" asp-route-id="@account.UserId" method="post"
                                  onsubmit="return confirm('確定要把 @account.DisplayName 改成主管嗎？他將可以核准報銷單、管理預支款與使用者。');">
                                <input type="hidden" name="role" value="@ExpenseLiteRoles.Manager" />
                                <button type="submit" class="btn btn-ghost">改為主管</button>
                            </form>
                        }

                        <a class="btn btn-ghost" asp-action="ResetPassword" asp-route-id="@account.UserId">重設密碼</a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <div class="el-page-foot el-page-foot--single">
        <span>改角色或停用之後，對方目前開著的瀏覽器最慢會在 30 分鐘內失效（Identity 重新驗證登入 cookie 的間隔）。</span>
        <span><strong>緊急存取帳號</strong>只在沒有其他主管進得來時使用，平常不該有登入紀錄。上面的「最後登入」如果出現你沒有印象的時間，請立即用「重設密碼」換掉它。</span>
    </div>
</div>

@functions {
    // 啟用＝青（在線上），停用＝灰（不在流程中）。
    private static string StatusClass(UserAccountStatus status) => status switch
    {
        UserAccountStatus.Active => "el-status--active",
        UserAccountStatus.Disabled => "el-status--disabled",
        _ => "el-status--disabled"
    };

    @* LastSignInText / StatusText 沿用原檔，未改動。
       原本的 StatusBadgeClass 可以刪掉，改用上面的 StatusClass。 *@
}
