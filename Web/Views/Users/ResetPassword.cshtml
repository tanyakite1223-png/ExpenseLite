@model ResetUserPasswordForm

@{
    ViewData["Title"] = "重設密碼";
}

<div class="el-page el-page--form">
    <a asp-action="Index">← 返回使用者列表</a>
    <h1 class="el-title el-title--form">重設密碼</h1>

    <div class="el-notice el-notice--warn">
        重設後舊密碼立刻失效。新密碼請當面或用其他管道交給本人，並提醒他登入後自行修改。
    </div>

    <p class="el-reset-target"><strong>修改帳號：@Model.DisplayName（@Model.UserName）</strong></p>

    <form asp-action="ResetPassword" method="post" class="el-fields el-fields--inline">
        <div asp-validation-summary="ModelOnly" class="el-error"></div>

        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="DisplayName" />
        <input type="hidden" asp-for="UserName" />

        <div class="field">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" class="input" autocomplete="new-password" autofocus />
            <div class="el-hint">至少 8 個字，需包含大寫、小寫英文字母與數字。</div>
            <span asp-validation-for="NewPassword" class="el-error"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmNewPassword"></label>
            <input asp-for="ConfirmNewPassword" class="input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmNewPassword" class="el-error"></span>
        </div>

        <div class="el-actions">
            <button type="submit" class="btn btn-primary">重設密碼</button>
            <a class="btn btn-secondary" asp-action="Index">取消</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
