@model ResetUserPasswordForm

@{
    ViewData["Title"] = "重設密碼";
}

<div class="mb-3">
    <a asp-action="Index">返回使用者列表</a>
</div>

<div class="row">
    <div class="col-md-5">
        <h1 class="h3 mb-1">重設密碼</h1>
        <div class="text-muted mb-4">@Model.DisplayName（@Model.UserName）</div>

        <div class="alert alert-warning">
            重設後舊密碼立刻失效。新密碼請當面或用其他管道交給本人，並提醒他登入後自行修改。
        </div>

        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="DisplayName" />
            <input type="hidden" asp-for="UserName" />

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
                <div class="form-text">至少 8 個字，需包含大寫、小寫英文字母與數字。</div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmNewPassword" class="form-label"></label>
                <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">重設密碼</button>
            <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
