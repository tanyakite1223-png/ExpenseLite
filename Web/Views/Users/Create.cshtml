@model CreateUserForm

@{
    ViewData["Title"] = "新增使用者";
}

<div class="mb-3">
    <a asp-action="Index">返回使用者列表</a>
</div>

<div class="row">
    <div class="col-md-5">
        <h1 class="h3 mb-1">新增使用者</h1>
        <div class="text-muted mb-4">建立完成後帳號立刻可以登入。</div>

        <div class="alert alert-warning">
            預設密碼請當面或用其他管道交給本人，並提醒他登入後用「修改密碼」自行換掉。
        </div>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName" class="form-control" autocomplete="off" autofocus />
                <div class="form-text">登入時輸入的帳號，習慣上用 Email 的前綴，例如 <code>amber</code>。</div>
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label"></label>
                <input asp-for="DisplayName" class="form-control" autocomplete="off" />
                <div class="form-text">報銷單、審核紀錄上會顯示這個名字。</div>
                <span asp-validation-for="DisplayName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="off" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" class="form-select">
                    @foreach (var role in ExpenseLiteRoles.All)
                    {
                        <option value="@role">@ExpenseLiteRoles.GetDisplayName(role)</option>
                    }
                </select>
                <div class="form-text">主管可以核准報銷單、管理預支款與使用者。之後也能在列表上改。</div>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <div class="form-text">至少 8 個字，需包含大寫、小寫英文字母與數字。</div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">建立帳號</button>
            <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
