@model CreateUserForm

@{
    ViewData["Title"] = "新增使用者";
}

<div class="el-page el-page--form">
    <a asp-action="Index">← 返回使用者列表</a>
    <h1 class="el-title el-title--form">新增使用者</h1>
    <p class="el-lede">建立完成後帳號立刻可以登入。</p>

    <div class="el-notice el-notice--warn">
        預設密碼請當面或用其他管道交給本人，並提醒他登入後用「修改密碼」自行換掉。
    </div>

    <form asp-action="Create" method="post" class="el-fields el-fields--inline">
        <div asp-validation-summary="ModelOnly" class="el-error"></div>

        <div class="field">
            <label asp-for="UserName"></label>
            <input asp-for="UserName" class="input" autocomplete="off" autofocus />
            <div class="el-hint">登入時輸入的帳號，習慣上用 Email 的前綴，例如 <code>amber</code>。</div>
            <span asp-validation-for="UserName" class="el-error"></span>
        </div>

        <div class="field">
            <label asp-for="DisplayName"></label>
            <input asp-for="DisplayName" class="input" autocomplete="off" />
            <div class="el-hint">報銷單、審核紀錄上會顯示這個名字。</div>
            <span asp-validation-for="DisplayName" class="el-error"></span>
        </div>

        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="input" autocomplete="off" />
            <span asp-validation-for="Email" class="el-error"></span>
        </div>

        <div class="field">
            <label asp-for="Role"></label>
            <select asp-for="Role" class="input">
                @foreach (var role in ExpenseLiteRoles.All)
                {
                    <option value="@role">@ExpenseLiteRoles.GetDisplayName(role)</option>
                }
            </select>
            <div class="el-hint">主管可以核准報銷單、管理預支款與使用者。之後也能在列表上改。</div>
            <span asp-validation-for="Role" class="el-error"></span>
        </div>

        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="input" autocomplete="new-password" />
            <div class="el-hint">至少 8 個字，需包含大寫、小寫英文字母與數字。</div>
            <span asp-validation-for="Password" class="el-error"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="el-error"></span>
        </div>

        <div class="el-actions">
            <button type="submit" class="btn btn-primary">建立帳號</button>
            <a class="btn btn-secondary" asp-action="Index">取消</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
