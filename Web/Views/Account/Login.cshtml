@model LoginForm

@{
    ViewData["Title"] = "登入";
    Layout = "_LayoutLogin";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div>
    <h2 class="el-panel-title">登入</h2>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="el-notice">@successMessage</div>
    }

    <form asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" class="el-fields">
        <div asp-validation-summary="ModelOnly" class="el-error"></div>

        <div class="field">
            <label asp-for="UserName">帳號</label>
            <input asp-for="UserName" class="input" autocomplete="username" autofocus />
            <span asp-validation-for="UserName" class="el-error"></span>
        </div>

        <div class="field">
            <label asp-for="Password">密碼</label>
            @* 切換鈕由 el-password-toggle.js 自己補上，這裡只要包一層並標記。 *@
            <span class="el-password">
                <input asp-for="Password" class="input" type="password" autocomplete="current-password" data-el-password />
            </span>
            <span asp-validation-for="Password" class="el-error"></span>
        </div>

        <label class="radio">
            <input asp-for="RememberMe" type="checkbox" />
            <span class="dot square"></span>
            <span>記住我</span>
        </label>

        <button type="submit" class="btn btn-primary btn-block">登入</button>
    </form>

    <p class="el-lede">忘記密碼或登不進去，請洽主管重設。</p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/el-password-toggle.js" asp-append-version="true"></script>
}
