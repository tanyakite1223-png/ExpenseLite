@model ChangePasswordForm

@{
    ViewData["Title"] = "修改密碼";
    var mustChange = User.MustChangePassword();
    // 被強制改密碼的人還沒真正進到系統，所以走登入版式的第 2 步，不要套一般 Layout。
    if (mustChange) { Layout = "_LayoutLogin"; }
}

<div class="@(!mustChange ? "el-page el-page--form" : null)">
    @if (mustChange)
    {
        <div class="el-kicker el-kicker--warn">第 2 步，共 2 步</div>
        <h2 class="el-panel-title el-panel-title--step">先換掉預設密碼</h2>
        <p class="el-lede">你用的是主管給的預設密碼。換好之後就會直接進入系統，不用再登入一次。</p>
    }
    else
    {
        <h1 class="el-title el-title--form">修改密碼</h1>
    }

    <form asp-action="ChangePassword" method="post" class="el-fields">
        <div asp-validation-summary="ModelOnly" class="el-error"></div>

        <div class="field">
            <label asp-for="CurrentPassword">目前密碼</label>
            <input asp-for="CurrentPassword" class="input" autocomplete="current-password" autofocus />
            <span asp-validation-for="CurrentPassword" class="el-error"></span>
        </div>

        <div class="field">
            <label asp-for="NewPassword">新密碼</label>
            <input asp-for="NewPassword" class="input" autocomplete="new-password" data-el-strength />
            <span asp-validation-for="NewPassword" class="el-error"></span>
        </div>

        @* 強度三格 + 規則清單。JS 只負責加／移除 .on，規則本身仍由後端 Identity 驗。 *@
        <div>
            <div class="el-strength" data-el-strength-bars>
                <span></span><span></span><span></span>
            </div>
            <div class="el-rules">
                <span data-el-rule="len">· 至少 8 個字</span>
                <span data-el-rule="case">· 大小寫英文字母都要有</span>
                <span data-el-rule="num">· 至少一個數字</span>
            </div>
        </div>

        <div class="field">
            <label asp-for="ConfirmNewPassword">再輸入一次</label>
            <input asp-for="ConfirmNewPassword" class="input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmNewPassword" class="el-error"></span>
        </div>

        <div class="el-actions">
            <button type="submit" class="btn btn-primary @(mustChange ? "btn-block" : "")">
                @(mustChange ? "換好密碼，進入系統" : "更新密碼")
            </button>
            @if (!mustChange)
            {
                <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">返回首頁</a>
            }
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/el-password-strength.js" asp-append-version="true"></script>
}
