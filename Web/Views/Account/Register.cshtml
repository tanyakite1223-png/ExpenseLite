@model RegisterForm

@{
    ViewData["Title"] = "註冊帳號";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h3 mb-1">註冊 ExpenseLite 帳號</h1>
        <div class="text-muted small mb-4">送出後帳號需要主管啟用才能登入。</div>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName" class="form-control" autocomplete="username" autofocus />
                <div class="form-text">登入時輸入的帳號，習慣上用 Email 的前綴，例如 <code>amber</code>。</div>
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label"></label>
                <input asp-for="DisplayName" class="form-control" autocomplete="name" />
                <div class="form-text">報銷單、審核紀錄上會顯示這個名字。</div>
                <span asp-validation-for="DisplayName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <div class="form-text">至少 8 個字，需包含大寫、小寫英文字母與數字。</div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">送出註冊</button>
        </form>

        <div class="text-center mt-3">
            <a asp-action="Login">已經有帳號了，前往登入</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
