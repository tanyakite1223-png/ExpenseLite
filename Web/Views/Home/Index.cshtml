@model HomePageDto

@{
    ViewData["Title"] = "首頁";
}


<div class="el-page">
    <div class="el-home el-home--flush">
        <div>
            @if (Model.Lede is null)
            {
                <h1 class="el-title">目前沒有等你處理的事</h1>
                <p class="el-lede-why">有新的報銷單送審或預支款需要結清時，會出現在這裡。</p>
            }
            else
            {
                <div class="el-kicker el-kicker--accent">最該先做的</div>
                <div class="el-lede-count">
                    <span class="el-lede-num">@Model.Lede.Count</span>
                    <span class="el-lede-what">@Model.Lede.What</span>
                </div>
                <p class="el-lede-why">@Model.Lede.Why</p>
                <div class="el-actions">
                    <a class="btn btn-primary" href="@Model.Lede.Url">前往處理</a>
                </div>

                @if (Model.Items.Count > 0)
                {
                    <div class="el-rail-sep"></div>
                    <div class="el-kicker">其餘待辦</div>
                    <div class="el-todos">
                    @foreach (var todo in Model.Items)
                    {
                        <a class="el-todo @(todo.NeedsAttention ? "el-todo--warn" : "")" href="@todo.Url">
                            <span class="el-todo-num">@todo.Count</span>
                            <span>
                                <span class="el-todo-what">@todo.What</span>
                                <span class="el-todo-why">@todo.Why</span>
                            </span>
                        </a>
                    }
                    </div>
                }
            }
        </div>

        <div class="el-home-aside">
            <div class="el-kicker">開一張新的</div>
            <div class="el-quick">
                <a class="btn btn-secondary btn-block" asp-controller="ExpenseReports" asp-action="Create">新增報銷單</a>
                @if (Model.IsManager)
                {
                    <a class="btn btn-secondary btn-block" asp-controller="CashAdvances" asp-action="Create">新增預支款</a>
                    <a class="btn btn-secondary btn-block" asp-controller="Projects" asp-action="Create">新增專案</a>
                }
            </div>
        </div>
    </div>
</div>
