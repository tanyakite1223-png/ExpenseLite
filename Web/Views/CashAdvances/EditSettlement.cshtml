@model EditCashAdvanceSettlementPage

@{
    ViewData["Title"] = "修改結清紀錄";
}

<div class="el-page el-page--form">
    <a asp-action="Details" asp-route-id="@Model.CashAdvance.Id">← 返回預支款詳情</a>
    <h1 class="el-title el-title--form">修改結清紀錄</h1>

    @* 方向不可改——方向是核對算式決定的。要換方向得先標記不採用再重新結清。 *@
    <dl class="el-facts">
        <dt>領款人</dt>
        <dd>@Model.CashAdvance.PayeeName</dd>
        <dt>用途</dt>
        <dd>@Model.CashAdvance.Purpose</dd>
        <dt>結清方向</dt>
        <dd>@SettlementTypeText(Model.SettlementRecord.SettlementType)</dd>
    </dl>

    <form asp-action="EditSettlement"
          asp-route-id="@Model.CashAdvance.Id"
          asp-route-settlementRecordId="@Model.SettlementRecord.Id"
          method="post" class="el-fields el-fields--inline">
        <div asp-validation-summary="ModelOnly" class="el-error"></div>
        <input asp-for="Settlement.CashAdvanceId" type="hidden" />
        <input asp-for="Settlement.SettlementRecordId" type="hidden" />

        <div class="field">
            <label asp-for="Settlement.SettledAt">結清日期</label>
            <input asp-for="Settlement.SettledAt" type="date" class="input" />
            <span asp-validation-for="Settlement.SettledAt" class="el-error"></span>
        </div>

        <div class="field">
            <label asp-for="Settlement.Amount">結清金額</label>
            <input asp-for="Settlement.Amount" class="input" inputmode="decimal" />
            <span asp-validation-for="Settlement.Amount" class="el-error"></span>
        </div>

        <div class="field">
            <label>處理人</label>
            <input class="input el-readonly" value="@Model.SettlementRecord.HandledBy" readonly />
            <div class="el-hint">處理人是當初登記這筆結清的人，修改內容不會改掉它。</div>
        </div>

        <div class="field">
            <label asp-for="Settlement.Note">備註</label>
            <textarea asp-for="Settlement.Note" class="input el-desc" rows="3"></textarea>
            <span asp-validation-for="Settlement.Note" class="el-error"></span>
        </div>

        <div class="el-actions">
            <button type="submit" class="btn btn-primary">儲存修改</button>
            <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.CashAdvance.Id">取消</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@functions {
    private static string SettlementTypeText(CashAdvanceSettlementType settlementType)
        => settlementType switch
        {
            CashAdvanceSettlementType.CompanyPaid => "公司補付",
            CashAdvanceSettlementType.EmployeeReturned => "員工繳回",
            _ => settlementType.ToString()
        };
}
