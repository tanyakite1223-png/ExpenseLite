@model CreateCashAdvanceForm

@{
    ViewData["Title"] = "新增預支款";
}

<div class="el-page el-page--form">
    <a asp-action="Index">← 返回列表</a>
    <h1 class="el-title el-title--form">新增預支款</h1>

    <form asp-action="Create" method="post" class="el-fields el-fields--inline">
        <div asp-validation-summary="ModelOnly" class="el-error"></div>

        <div class="field">
            <label asp-for="PayeeUserId">領款人</label>
            <select asp-for="PayeeUserId" class="input">
                <option value="">請選擇</option>
                @foreach (var payee in Model.PayeeOptions)
                {
                    <option value="@payee.UserId">@payee.DisplayName</option>
                }
            </select>
            <div class="el-hint">領款人是拿到這筆錢的人，不一定是現在登入的你；只有他本人的報銷單能引用這筆預支款。</div>
            <span asp-validation-for="PayeeUserId" class="el-error"></span>
        </div>

        <div class="field">
            <label asp-for="Purpose">預支用途</label>
            <input asp-for="Purpose" class="input" autocomplete="off" />
            <span asp-validation-for="Purpose" class="el-error"></span>
        </div>

        <div class="field">
            <label asp-for="AdvancedAt">預支日期</label>
            <input asp-for="AdvancedAt" type="date" class="input" />
            <span asp-validation-for="AdvancedAt" class="el-error"></span>
        </div>

        <div class="field">
            <label asp-for="Amount">預支金額</label>
            @* 新增時不要預填 0.00，使用者得先刪掉才能打字 *@
            <input asp-for="Amount" class="input" inputmode="decimal" value="@(Model.Amount == 0m ? string.Empty : Model.Amount.ToString("0.##"))" />
            <span asp-validation-for="Amount" class="el-error"></span>
        </div>

        <div class="el-actions">
            <button type="submit" class="btn btn-primary">建立</button>
            <a class="btn btn-secondary" asp-action="Index">取消</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
