@model CreateCashAdvanceForm

@{
    ViewData["Title"] = "新增預支款";
}

<div class="mb-3">
    <a asp-action="Index">返回列表</a>
</div>

<h1 class="h3 mb-3">新增預支款</h1>

<form asp-action="Create" method="post" class="col-lg-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="PayeeUserId" class="form-label">領款人</label>
        <select asp-for="PayeeUserId" class="form-select">
            <option value="">請選擇</option>
            @foreach (var payee in Model.PayeeOptions)
            {
                <option value="@payee.UserId">@payee.DisplayName</option>
            }
        </select>
        <div class="form-text">領款人是拿到這筆錢的人，不一定是現在登入的你。</div>
        <span asp-validation-for="PayeeUserId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Usage" class="form-label">用途類型</label>
        <select asp-for="Usage" class="form-select">
            <option value="@CashAdvanceUsage.Personal">個人預支</option>
            <option value="@CashAdvanceUsage.PettyCash">零用金（共用）</option>
        </select>
        <div class="form-text">
            個人預支只有領款人本人的報銷單能引用；零用金由領款人保管，所有人的報銷單都能引用。
        </div>
        <span asp-validation-for="Usage" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Purpose" class="form-label">預支用途</label>
        <input asp-for="Purpose" class="form-control" autocomplete="off" />
        <span asp-validation-for="Purpose" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AdvancedAt" class="form-label">預支日期</label>
        <input asp-for="AdvancedAt" type="date" class="form-control" />
        <span asp-validation-for="AdvancedAt" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label">預支金額</label>
        <input asp-for="Amount" class="form-control" inputmode="decimal" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">建立</button>
    <a class="btn btn-outline-secondary" asp-action="Index">取消</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
