@using ExpenseLite.Web.ViewModels.ExpenseCategories
@model CreateExpenseCategoryForm

@{
    ViewData["Title"] = "新增類別";
}

<div class="el-page el-page--form">
    <a asp-action="Index">← 返回列表</a>
    <h1 class="el-title el-title--form">新增類別</h1>

    <div asp-validation-summary="ModelOnly" class="el-error"></div>
    <form asp-action="Create" method="post" class="el-fields el-fields--inline">
        <div class="field" style="grid-template-columns: 50px 1fr">
            <label asp-for="Name">類別名稱</label>
            <input asp-for="Name" class="input" autocomplete="off" placeholder="例：交通、餐費、住宿" style="max-width: 240px" />
            <span asp-validation-for="Name" class="el-error"></span>
        </div>
        <div class="el-actions" style="padding-left: 65px">
            <button type="submit" class="btn btn-primary">新增</button>
            <a class="btn btn-secondary" asp-action="Index">取消</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
