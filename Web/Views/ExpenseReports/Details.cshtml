@model ExpenseReportDetailsPage

@{
    ViewData["Title"] = Model.Report.Title;
    // 這些旗標只決定「按鈕要不要顯示」，是 UX。真正把關的是 Application Service 與 [Authorize]。
    var isApplicant = Model.Report.ApplicantUserId == User.GetUserId();
    var isManager = User.IsManager();
    var canEdit = isApplicant && Model.Report.Status is ExpenseReportStatus.Draft or ExpenseReportStatus.Returned;
    var canReview = isManager && !isApplicant && Model.Report.Status is ExpenseReportStatus.Submitted;
    var canVoid = isManager && !isApplicant && Model.Report.Status is ExpenseReportStatus.Approved;
    var canDelete = isApplicant && Model.Report.Status is ExpenseReportStatus.Draft;
    var canCancel = isApplicant && Model.Report.Status is ExpenseReportStatus.Returned;
    var canRestore = isApplicant && Model.Report.Status is ExpenseReportStatus.Cancelled;
    var isClosedProjectReport = Model.Report.ExpenseType == ExpenseType.Project
        && Model.Report.ProjectStatus == ProjectStatus.Closed;
    var canSubmit = canEdit && Model.Report.Details.Count > 0 && !isClosedProjectReport;
}

<div class="el-page">
    <a asp-action="Index">← 返回列表</a>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="el-notice el-notice--warn">@errorMessage</div>
    }
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="el-notice">@successMessage</div>
    }

    @if (isClosedProjectReport && canEdit)
    {
        <div class="el-notice el-notice--warn">這張報銷單連到已結案專案，不可送審。</div>
    }

    @* 作廢後的持續提示：核對算式即時扣掉了這張單，但已計入的結清紀錄不會自己動。 *@
    @if (Model.Report.Status == ExpenseReportStatus.Voided && Model.Report.AdoptedSettlementRecordCount > 0)
    {
        <div class="el-notice el-notice--warn">
            <strong>這張單已作廢，但錢還沒收拾乾淨。</strong>
            對應預支款上仍有 @Model.Report.AdoptedSettlementRecordCount 筆已計入的結清紀錄。
            「已核准報銷」金額已即時扣掉這張單，那些結清紀錄不會自動變動——請到預支款詳情頁手動處理
            （標記不採用，或補一筆反向結清紀錄）。
        </div>
    }

    @if (Model.Report.Status == ExpenseReportStatus.Cancelled)
    {
        <div class="el-notice el-notice--quiet">
            這張單目前是「已取消」，不在流程中，列表預設也不顯示。
            @if (canRestore)
            {
                <text>復活後會回到退回狀態，就能繼續編輯重送。</text>
            }
        </div>
    }

    <div class="el-head">
        <div>
            <div class="el-status-line">
                <span class="tag el-status @StatusClass(Model.Report.Status)">@StatusText(Model.Report.Status)</span>
                <span class="el-hint">
                    建立於 @Model.Report.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")．申請人 @Model.Report.ApplicantName
                </span>
            </div>
            <h1 class="el-title">@Model.Report.Title</h1>
            <div class="el-meta">
                <span>支出類型：@ExpenseTypeText(Model.Report.ExpenseType)</span>
                <span>專案：@DisplayProjectName(Model.Report)</span>
                <span>付款方式：@PaymentMethodText(Model.Report.PaymentMethod)</span>
                @if (Model.Report.PaymentMethod == ExpensePaymentMethod.PersonalAdvance)
                {
                    <span>對應預支款：@DisplayCashAdvance(Model.Report.CashAdvance)</span>
                }
                else if (Model.Report.PaymentMethod == ExpensePaymentMethod.PettyCash)
                {
                    @* 讓主管審核時看得出來不用再付款。 *@
                    <span>這筆是從零用金支付的，公司不需要再付款給申請人。</span>
                }
            </div>
        </div>
        <div>
            <div class="el-kicker">總金額</div>
            <div class="el-total el-total--sm">@Model.Report.TotalAmount.ToString("N2")</div>
            <div class="el-actions el-actions--end">
                @if (canEdit)
                {
                    <a class="btn btn-secondary btn-sm" asp-action="Edit" asp-route-id="@Model.Report.Id">修改報銷單</a>
                }
                @if (canDelete)
                {
                    <form asp-action="Delete" asp-route-id="@Model.Report.Id" method="post"
                          onsubmit="return confirm('確定要刪除這張草稿嗎？這個動作無法復原。');">
                        <button type="submit" class="btn btn-outline-danger btn-sm">刪除草稿</button>
                    </form>
                }
                @if (canCancel)
                {
                    <form asp-action="Cancel" asp-route-id="@Model.Report.Id" method="post"
                          onsubmit="return confirm('確定要取消這張退回單嗎？取消後不會消失，可隨時從詳情頁復活。');">
                        <button type="submit" class="btn btn-secondary btn-sm">放棄這張單</button>
                    </form>
                }
                @if (canRestore)
                {
                    <form asp-action="Restore" asp-route-id="@Model.Report.Id" method="post">
                        <button type="submit" class="btn btn-primary btn-sm">復活這張單</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="el-split">
        <div>
            <div class="el-section-head">
                <h2 class="el-kicker">明細</h2>
                @if (canSubmit)
                {
                    <form asp-action="Submit" asp-route-id="@Model.Report.Id" method="post">
                        <button type="submit" class="btn btn-primary btn-sm">送審</button>
                    </form>
                }
            </div>

            @if (Model.Report.Details.Count == 0)
            {
                <div class="el-notice el-notice--quiet">尚未加入明細。</div>
            }
            else
            {
                <table class="table el-table el-table--details">
                    <thead>
                        <tr>
                            <th>日期</th>
                            <th>類別</th>
                            <th>說明</th>
                            <th>單據</th>
                            <th>發票號碼</th>
                            <th>金額</th>
                            @if (canEdit) { <th></th> }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var detail in Model.Report.Details)
                    {
                        <tr>
                            <td class="nowrap">@detail.ExpenseDate.ToString("yyyy/MM/dd")</td>
                            <td>@detail.Category</td>
                            <td>@detail.Description</td>
                            <td>@ReceiptTypeText(detail.ReceiptType)</td>
                            <td>@DisplayInvoiceNumber(detail)</td>
                            <td class="num">@detail.Amount.ToString("N2")</td>
                            @if (canEdit)
                            {
                                <td>
                                    <div class="el-cell-actions">
                                        <a class="btn btn-ghost"
                                           asp-action="Details"
                                           asp-route-id="@Model.Report.Id"
                                           asp-route-editDetailId="@detail.Id">修改</a>
                                        <form asp-action="RemoveDetail" asp-route-id="@Model.Report.Id" asp-route-detailId="@detail.Id" method="post">
                                            <button type="submit" class="btn btn-ghost btn-remove">移除</button>
                                        </form>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            }

            <h2 class="el-kicker el-kicker--section">審核紀錄</h2>
            @if (Model.Report.ReviewRecords.Count == 0)
            {
                <div class="el-hint">尚無審核紀錄。</div>
            }
            else
            {
                <div class="el-timeline">
                @foreach (var review in Model.Report.ReviewRecords)
                {
                    <div class="el-timeline-row">
                        <div class="el-timeline-at">@review.ReviewedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
                        <div>
                            <div class="el-timeline-act">@ReviewActionText(review.Action)．@review.ReviewerName</div>
                            <div class="el-timeline-why">@DisplayReviewReason(review)</div>
                        </div>
                    </div>
                }
                </div>
            }
        </div>

        <div class="el-rail">
            @if (canEdit)
            {
                @if (Model.EditDetail is not null)
                {
                    <div class="el-rail-label">修改明細</div>
                    <form asp-action="UpdateDetail" asp-route-id="@Model.Report.Id" asp-route-detailId="@Model.EditDetail.Id" method="post" class="el-fields">
                        <div asp-validation-summary="ModelOnly" class="el-error"></div>
                        <div class="field">
                            <label asp-for="EditDetail.ExpenseDate">日期</label>
                            <input asp-for="EditDetail.ExpenseDate" name="ExpenseDate" type="date" class="input" />
                            <span asp-validation-for="EditDetail.ExpenseDate" class="el-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="EditDetail.Category">類別</label>
                            <input asp-for="EditDetail.Category" name="Category" class="input" autocomplete="off" />
                            <span asp-validation-for="EditDetail.Category" class="el-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="EditDetail.Description">說明</label>
                            <textarea asp-for="EditDetail.Description" name="Description" class="input el-desc" rows="3"></textarea>
                            <span asp-validation-for="EditDetail.Description" class="el-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="EditDetail.ReceiptType">單據類型</label>
                            <select asp-for="EditDetail.ReceiptType" name="ReceiptType" class="input">
                                <option value="@ExpenseReceiptType.Receipt">收據</option>
                                <option value="@ExpenseReceiptType.Invoice">發票</option>
                            </select>
                        </div>
                        <div class="field">
                            <label asp-for="EditDetail.InvoiceNumber">發票號碼</label>
                            <input asp-for="EditDetail.InvoiceNumber" name="InvoiceNumber" class="input" autocomplete="off" />
                            <div class="el-hint">單據類型為發票時必填。</div>
                            <span asp-validation-for="EditDetail.InvoiceNumber" class="el-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="EditDetail.Amount">金額</label>
                            <input asp-for="EditDetail.Amount" name="Amount" class="input" inputmode="decimal" />
                            <span asp-validation-for="EditDetail.Amount" class="el-error"></span>
                        </div>
                        <div class="el-actions">
                            <button type="submit" class="btn btn-primary">儲存明細</button>
                            <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.Report.Id">取消</a>
                        </div>
                    </form>
                }
                else
                {
                    <div class="el-rail-label">新增明細</div>
                    <form asp-action="AddDetail" asp-route-id="@Model.Report.Id" method="post" class="el-fields">
                        <div asp-validation-summary="ModelOnly" class="el-error"></div>
                        <div class="field">
                            <label asp-for="NewDetail.ExpenseDate">日期</label>
                            <input asp-for="NewDetail.ExpenseDate" type="date" class="input" />
                            <span asp-validation-for="NewDetail.ExpenseDate" class="el-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="NewDetail.Category">類別</label>
                            <input asp-for="NewDetail.Category" class="input" autocomplete="off" placeholder="交通、餐費、住宿…" />
                            <span asp-validation-for="NewDetail.Category" class="el-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="NewDetail.Description">說明</label>
                            <textarea asp-for="NewDetail.Description" class="input el-desc" rows="3" placeholder="這筆花在什麼上，需要時可以寫長一點"></textarea>
                            <span asp-validation-for="NewDetail.Description" class="el-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="NewDetail.ReceiptType">單據類型</label>
                            <select asp-for="NewDetail.ReceiptType" class="input">
                                <option value="@ExpenseReceiptType.Receipt">收據</option>
                                <option value="@ExpenseReceiptType.Invoice">發票</option>
                            </select>
                        </div>
                        <div class="field">
                            <label asp-for="NewDetail.InvoiceNumber">發票號碼</label>
                            <input asp-for="NewDetail.InvoiceNumber" class="input" autocomplete="off" />
                            <div class="el-hint">單據類型為發票時必填。</div>
                            <span asp-validation-for="NewDetail.InvoiceNumber" class="el-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="NewDetail.Amount">金額</label>
                            @* 新增時不要預填 0.00 *@
                            <input asp-for="NewDetail.Amount" class="input" inputmode="decimal" value="@(Model.NewDetail.Amount == 0m ? string.Empty : Model.NewDetail.Amount.ToString("0.##"))" />
                            <span asp-validation-for="NewDetail.Amount" class="el-error"></span>
                        </div>
                        <div class="el-actions">
                            <button type="submit" class="btn btn-primary">加入明細</button>
                        </div>
                    </form>
                }
            }
            else if (!isApplicant)
            {
                <div class="el-notice el-notice--quiet">只有申請人可以修改這張報銷單的明細。</div>
            }
            else
            {
                <div class="el-notice el-notice--quiet">@NonEditableReasonText(Model.Report.Status)</div>
            }

            @if (canReview)
            {
                <div class="el-rail-sep"></div>
                <div class="el-rail-label">你要怎麼處理</div>
                <form method="post" class="el-fields">
                    @Html.AntiForgeryToken()
                    <div class="field">
                        <label asp-for="Review.Reason">退回／拒絕原因</label>
                        <textarea asp-for="Review.Reason" name="Reason" class="input" rows="4"
                                  placeholder="核准可留空；退回與拒絕必填"></textarea>
                        <span asp-validation-for="Review.Reason" class="el-error"></span>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block"
                            formaction="@Url.Action("Approve", new { id = Model.Report.Id })">核准</button>
                    <button type="submit" class="btn btn-secondary btn-block"
                            formaction="@Url.Action("Return", new { id = Model.Report.Id })">退回請他改</button>
                    <button type="submit" class="btn btn-outline-danger btn-block"
                            formaction="@Url.Action("Reject", new { id = Model.Report.Id })">拒絕</button>
                    <div class="el-hint">退回是「回去改」，還能重送；拒絕是終點，這張單不會再回來。</div>
                </form>
            }

            @if (canVoid)
            {
                <div class="el-rail-sep"></div>
                <div class="el-rail-label">作廢處理</div>
                @if (Model.Report.AdoptedSettlementRecordCount > 0)
                {
                    @* 作廢前的提示：攔在動作發生前，讓主管當下就意識到後果。 *@
                    <div class="el-notice el-notice--warn el-notice--rail">
                        <strong>先看這個。</strong>
                        這張單牽動對應預支款上 @Model.Report.AdoptedSettlementRecordCount 筆已計入的結清紀錄。
                        作廢後「已核准報銷」會即時變動，但那幾筆結清紀錄不會自己動，要你到預支款詳情頁手動處理。
                    </div>
                }
                <form asp-action="Void" asp-route-id="@Model.Report.Id" method="post" class="el-fields"
                      onsubmit="return confirm('確定要作廢這張已核准的報銷單嗎？作廢後不可撤銷，要救只能重打一張新單。');">
                    <div asp-validation-summary="ModelOnly" class="el-error"></div>
                    <div class="field">
                        <label asp-for="Void.Reason">作廢原因（必填）</label>
                        <textarea asp-for="Void.Reason" name="Reason" class="input" rows="4" required
                                  placeholder="會寫進審核紀錄，日後查得到當時為什麼撤下這張單"></textarea>
                        <span asp-validation-for="Void.Reason" class="el-error"></span>
                    </div>
                    <button type="submit" class="btn btn-danger btn-block">作廢這張單</button>
                    <div class="el-hint">作廢不可撤銷。要救只能重打一張新單。</div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@functions {
    private static string StatusClass(ExpenseReportStatus status) => status switch
    {
        ExpenseReportStatus.Draft => "el-status--draft",
        ExpenseReportStatus.Submitted => "el-status--submitted",
        ExpenseReportStatus.Returned => "el-status--returned",
        ExpenseReportStatus.Approved => "el-status--approved",
        ExpenseReportStatus.Rejected => "el-status--rejected",
        ExpenseReportStatus.Voided => "el-status--voided",
        ExpenseReportStatus.Cancelled => "el-status--cancelled",
        _ => "el-status--cancelled"
    };

    private static string StatusText(ExpenseReportStatus status) => status switch
    {
        ExpenseReportStatus.Draft => "草稿",
        ExpenseReportStatus.Submitted => "送審中",
        ExpenseReportStatus.Returned => "退回",
        ExpenseReportStatus.Approved => "已核准",
        ExpenseReportStatus.Rejected => "已拒絕",
        ExpenseReportStatus.Voided => "已作廢",
        ExpenseReportStatus.Cancelled => "已取消",
        _ => status.ToString()
    };

    private static string PaymentMethodText(ExpensePaymentMethod paymentMethod) => paymentMethod switch
    {
        ExpensePaymentMethod.EmployeePaid => "員工墊款",
        ExpensePaymentMethod.PersonalAdvance => "個人預支",
        ExpensePaymentMethod.PettyCash => "零用金支付",
        _ => paymentMethod.ToString()
    };

    private static string ExpenseTypeText(ExpenseType expenseType) => expenseType switch
    {
        ExpenseType.General => "一般支出",
        ExpenseType.Project => "專案支出",
        _ => expenseType.ToString()
    };

    private static string DisplayProjectName(ExpenseReportDetailDto report)
        => report.ExpenseType == ExpenseType.Project ? report.ProjectName ?? "(找不到專案)" : "-";

    private static string DisplayCashAdvance(ExpenseReportCashAdvanceDto? cashAdvance)
        => cashAdvance is null
            ? "(找不到預支款)"
            : $"{cashAdvance.AdvancedAt:yyyy/MM/dd}．{cashAdvance.PayeeName}．{cashAdvance.Purpose}";

    private static string ReceiptTypeText(ExpenseReceiptType receiptType) => receiptType switch
    {
        ExpenseReceiptType.Receipt => "收據",
        ExpenseReceiptType.Invoice => "發票",
        _ => receiptType.ToString()
    };

    private static string DisplayInvoiceNumber(ExpenseDetailDto detail)
        => detail.ReceiptType == ExpenseReceiptType.Invoice ? detail.InvoiceNumber : "-";

    private static string ReviewActionText(ExpenseReviewAction action) => action switch
    {
        ExpenseReviewAction.Returned => "退回",
        ExpenseReviewAction.Approved => "核准",
        ExpenseReviewAction.Rejected => "拒絕",
        ExpenseReviewAction.Voided => "作廢",
        _ => action.ToString()
    };

    private static string DisplayReviewReason(ExpenseReviewRecordDto review)
        => string.IsNullOrWhiteSpace(review.Reason) ? "-" : review.Reason;

    private static string NonEditableReasonText(ExpenseReportStatus status) => status switch
    {
        ExpenseReportStatus.Cancelled => "這張單已取消，要修改請先復活。",
        ExpenseReportStatus.Voided => "已作廢的報銷單不可修改。",
        _ => "報銷單送審後不可修改明細。"
    };
}
