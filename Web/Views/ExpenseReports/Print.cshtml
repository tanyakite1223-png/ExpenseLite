@model PrintReportDto

@{
    ViewData["Title"] = "列印報表";
    var isManager = User.IsManager();
    // 員工只看得到自己的資料，「按申請人」分組永遠只有一列（自己），
    // 跟頂部總計、下方自己那疊的小計三處重複，所以員工版不畫這組。
    var groups = new List<(string Title, IReadOnlyList<PrintReportGroupItem> Items)>();
    if (isManager) { groups.Add(("按申請人", Model.Summary.ByApplicant)); }
    groups.Add(("按支出類型", Model.Summary.ByExpenseType));
    groups.Add(("按付款方式", Model.Summary.ByPaymentMethod));
    groups.Add(("按專案", Model.Summary.ByProject));
}

@* 列印樣式全在 site.css 的 @@media print 區塊，這裡不放 style。
   螢幕上是操作介面（區間選擇、列印按鈕），紙上是給出納核對的憑單。 *@

<div class="el-page">
    <div class="el-print-head no-print">
        <div>
            <h1 class="el-title">列印報表</h1>
            <p class="el-sub">
                員工可以按區間列印自己已核准的報銷單，夾實體單據交給出納核對；
                主管看到的是同區間內全公司的支出。畫面上的控件列印時會自動隱藏。
            </p>
        </div>
        <div class="el-actions">
            <button type="button" class="btn btn-primary" onclick="window.print()">列印本頁</button>
            <a class="btn btn-secondary" asp-action="Index">回列表</a>
        </div>
    </div>

    <form method="get" asp-action="Print" class="el-filters el-filters--inline no-print">
        <div class="field">
            <label for="from">起</label>
            <input type="date" id="from" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="input" />
        </div>
        <div class="field">
            <label for="to">迄</label>
            <input type="date" id="to" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="input" />
        </div>
        <div class="el-actions">
            <button type="submit" class="btn btn-secondary">套用</button>
        </div>
    </form>
    <div class="el-hint no-print">區間依「送審時間」計算——這個月送出並已核准的單就是這個月要處理的量。</div>

    @* 這行在紙上是憑單的抬頭，說明這疊紙涵蓋什麼範圍，所以不加 no-print。 *@
    <div class="el-print-range">
        區間 <strong>@Model.From.ToString("yyyy/MM/dd")</strong> ～ <strong>@Model.To.ToString("yyyy/MM/dd")</strong>（狀態：已核准）
    </div>

    <div class="el-print-total">
        <h2 class="el-kicker">本區間彙總</h2>
        <div class="el-print-total-figure">
            共 <strong>@Model.Summary.TotalCount</strong> 張、合計 <strong>@Model.Summary.TotalAmount.ToString("N0")</strong> 元
        </div>
    </div>

    @if (Model.Summary.TotalCount == 0)
    {
        <div class="el-notice el-notice--quiet">
            本區間沒有已核准的報銷單。
            @if (!isManager)
            {
                <text>（你看到的是自己的資料——區間內沒有你送出的已核准單）</text>
            }
        </div>
    }
    else
    {
        <div class="el-sums">
        @foreach (var group in groups)
        {
            <div>
                <div class="el-sum-title">@group.Title</div>
                @if (group.Items.Count == 0)
                {
                    <div class="el-hint">（無資料）</div>
                }
                else
                {
                    @foreach (var item in group.Items)
                    {
                        <div class="el-sum-row">
                            <span>@item.Label</span>
                            <span class="el-sum-count">@item.Count 張</span>
                            <span class="el-sum-amount">@item.TotalAmount.ToString("N0")</span>
                        </div>
                    }
                }
            </div>
        }
        </div>

        @* 每位申請人一疊，列印時換人就換頁：出納收到一個人的一疊發票，
           就對這個人這一張紙打勾，一對一。同一人的多張單連續排列。 *@
        @foreach (var group in Model.Reports.GroupBy(x => x.ApplicantName))
        {
            var applicantTotal = group.Sum(x => x.TotalAmount);
            <section class="el-sheet">
                <div class="el-sheet-head">
                    <h3 class="el-sheet-name">@group.Key</h3>
                    <div class="el-sheet-total">
                        共 <strong>@group.Count()</strong> 張、合計 <strong>@applicantTotal.ToString("N0")</strong> 元
                    </div>
                </div>
                <div class="el-sheet-rule"></div>

                @foreach (var report in group)
                {
                    <div class="el-slip">
                        <div class="el-slip-head">
                            <div>
                                <div class="el-slip-title">@report.Title</div>
                                <div class="el-slip-meta">
                                    @ExpenseTypeText(report.ExpenseType)
                                    @if (report.ExpenseType == ExpenseType.Project)
                                    {
                                        <text>．專案：@(report.ProjectName ?? "（找不到專案）")</text>
                                    }
                                    ．付款方式：@PaymentMethodText(report.PaymentMethod)
                                    @if (report.CashAdvance is not null)
                                    {
                                        <text>．預支款：@report.CashAdvance.PayeeName／@report.CashAdvance.Purpose</text>
                                    }
                                </div>
                            </div>
                            <div class="el-slip-figure">
                                <div class="el-slip-amount">@report.TotalAmount.ToString("N0") 元</div>
                                <div class="el-slip-meta">送審 @(report.SubmittedAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "—")</div>
                            </div>
                        </div>

                        <table class="table el-table el-table--slip">
                            <thead>
                                <tr>
                                    <th>日期</th>
                                    <th>類別</th>
                                    <th>說明</th>
                                    <th>單據</th>
                                    <th>發票號碼</th>
                                    <th>金額</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var detail in report.Details)
                            {
                                <tr>
                                    <td class="nowrap">@detail.ExpenseDate.ToString("yyyy/MM/dd")</td>
                                    <td>@detail.Category</td>
                                    <td>@detail.Description</td>
                                    <td>@ReceiptTypeText(detail.ReceiptType)</td>
                                    <td>@(detail.ReceiptType == ExpenseReceiptType.Invoice ? detail.InvoiceNumber : "—")</td>
                                    <td class="num">@detail.Amount.ToString("N0")</td>
                                </tr>
                            }
                            </tbody>
                        </table>

                        @if (report.ReviewRecords.Any())
                        {
                            <div class="el-slip-reviews">
                                審核紀錄：
                                @foreach (var review in report.ReviewRecords.OrderBy(x => x.ReviewedAt))
                                {
                                    <text>
                                        @review.ReviewedAt.ToLocalTime().ToString("MM/dd HH:mm")
                                        @ReviewActionText(review.Action)
                                        ．@review.ReviewerName
                                        @if (!string.IsNullOrWhiteSpace(review.Reason))
                                        {
                                            <text>（@review.Reason）</text>
                                        }
                                    </text>
                                }
                            </div>
                        }
                    </div>
                }
            </section>
        }
    }
</div>

@functions {
    private static string ExpenseTypeText(ExpenseType expenseType) => expenseType switch
    {
        ExpenseType.General => "一般支出",
        ExpenseType.Project => "專案支出",
        _ => expenseType.ToString()
    };

    private static string PaymentMethodText(ExpensePaymentMethod paymentMethod) => paymentMethod switch
    {
        ExpensePaymentMethod.EmployeePaid => "員工墊款",
        ExpensePaymentMethod.PersonalAdvance => "個人預支",
        ExpensePaymentMethod.PettyCash => "零用金支付",
        _ => paymentMethod.ToString()
    };

    private static string ReceiptTypeText(ExpenseReceiptType receiptType) => receiptType switch
    {
        ExpenseReceiptType.Receipt => "收據",
        ExpenseReceiptType.Invoice => "發票",
        _ => receiptType.ToString()
    };

    private static string ReviewActionText(ExpenseReviewAction action) => action switch
    {
        ExpenseReviewAction.Returned => "退回",
        ExpenseReviewAction.Approved => "核准",
        ExpenseReviewAction.Rejected => "拒絕",
        ExpenseReviewAction.Voided => "作廢",
        _ => action.ToString()
    };
}
