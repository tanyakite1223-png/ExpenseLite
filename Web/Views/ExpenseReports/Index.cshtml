@model ExpenseReportListPageDto

@{
    ViewData["Title"] = "報銷單";
}

<div class="el-page">
    <div class="el-head">
        <div>
            <h1 class="el-title">報銷單</h1>
            <p class="el-sub">還在流程裡的有 @Model.UnfinishedCount 張，其中 @Model.AwaitingReviewCount 張等著主管處理。</p>
            @* 若 DTO 還沒有這兩個欄位，先改成原本那句：員工墊款、個人預支與零用金支付的申請與追蹤 *@
        </div>
        <div class="el-actions">
            <a class="btn btn-secondary" asp-action="Print">列印本月</a>
            <a class="btn btn-primary" asp-action="Create">新增報銷單</a>
        </div>
    </div>

    <form asp-action="Index" method="get" class="el-filters">
        <div class="field field--grow">
            <label for="keyword">關鍵字</label>
            <input type="search" id="keyword" name="keyword" value="@Model.Keyword" class="input" placeholder="搜尋標題、申請人" />
        </div>
        <div class="field field--sm">
            <label for="status">狀態</label>
            <select id="status" name="status" class="input">
                <option value="">全部</option>
                <option value="@ExpenseReportStatus.Draft" selected="@(Model.Status == ExpenseReportStatus.Draft)">草稿</option>
                <option value="@ExpenseReportStatus.Submitted" selected="@(Model.Status == ExpenseReportStatus.Submitted)">送審中</option>
                <option value="@ExpenseReportStatus.Returned" selected="@(Model.Status == ExpenseReportStatus.Returned)">退回</option>
                <option value="@ExpenseReportStatus.Approved" selected="@(Model.Status == ExpenseReportStatus.Approved)">已核准</option>
                <option value="@ExpenseReportStatus.Rejected" selected="@(Model.Status == ExpenseReportStatus.Rejected)">已拒絕</option>
                <option value="@ExpenseReportStatus.Voided" selected="@(Model.Status == ExpenseReportStatus.Voided)">已作廢</option>
                <option value="@ExpenseReportStatus.Cancelled" selected="@(Model.Status == ExpenseReportStatus.Cancelled)">已取消</option>
            </select>
        </div>
        <div class="field field--sm">
            <label for="expenseType">支出類型</label>
            <select id="expenseType" name="expenseType" class="input">
                <option value="">全部</option>
                <option value="@ExpenseType.General" selected="@(Model.ExpenseType == ExpenseType.General)">一般支出</option>
                <option value="@ExpenseType.Project" selected="@(Model.ExpenseType == ExpenseType.Project)">專案支出</option>
            </select>
        </div>
        <div class="field field--md">
            <label for="paymentMethod">付款方式</label>
            <select id="paymentMethod" name="paymentMethod" class="input">
                <option value="">全部</option>
                <option value="@ExpensePaymentMethod.EmployeePaid" selected="@(Model.PaymentMethod == ExpensePaymentMethod.EmployeePaid)">員工墊款</option>
                <option value="@ExpensePaymentMethod.PersonalAdvance" selected="@(Model.PaymentMethod == ExpensePaymentMethod.PersonalAdvance)">個人預支</option>
                <option value="@ExpensePaymentMethod.PettyCash" selected="@(Model.PaymentMethod == ExpensePaymentMethod.PettyCash)">零用金支付</option>
            </select>
        </div>
        @* 已取消單預設隱藏：申請人自己軟刪過的東西不該一直干擾列表。 *@
        <label class="radio">
            <input type="checkbox" id="includeCancelled" name="includeCancelled" value="true" @(Model.IncludeCancelled ? "checked" : "") />
            <span class="dot square"></span>
            <span>顯示已取消</span>
        </label>
        <div class="el-actions">
            <button type="submit" class="btn btn-secondary">篩選</button>
            @if (HasFilter(Model))
            {
                <a class="btn btn-ghost" asp-action="Index">清除</a>
            }
        </div>
    </form>

    <div class="el-count">共 @Model.Reports.Count 筆．已取消的單預設不列出</div>

    @if (Model.Reports.Count == 0)
    {
        <div class="el-notice el-notice--quiet">@EmptyReportMessage(Model)</div>
    }
    else
    {
        <table class="table el-table el-table--reports">
            <thead>
                <tr>
                    <th>標題</th>
                    <th>支出類型</th>
                    <th>專案</th>
                    <th>付款方式</th>
                    <th>狀態</th>
                    <th>總金額</th>
                    <th>建立</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var report in Model.Reports)
            {
                <tr>
                    <td class="strong">@report.Title</td>
                    <td>@ExpenseTypeText(report.ExpenseType)</td>
                    <td>@DisplayProjectName(report)</td>
                    <td>@PaymentMethodText(report.PaymentMethod)</td>
                    <td><span class="tag el-status @StatusClass(report.Status)">@StatusText(report.Status)</span></td>
                    <td class="num">@report.TotalAmount.ToString("N2")</td>
                    <td class="nowrap el-readonly">@report.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</td>
                    <td>
                        <div class="el-cell-actions">
                            <a class="btn btn-ghost" asp-action="Details" asp-route-id="@report.Id">檢視</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>

@functions {
    // 青＝流程順利，洋紅＝需要注意，灰＝不在流程中。
    private static string StatusClass(ExpenseReportStatus status) => status switch
    {
        ExpenseReportStatus.Draft => "el-status--draft",
        ExpenseReportStatus.Submitted => "el-status--submitted",
        ExpenseReportStatus.Returned => "el-status--returned",
        ExpenseReportStatus.Approved => "el-status--approved",
        ExpenseReportStatus.Rejected => "el-status--rejected",
        ExpenseReportStatus.Voided => "el-status--voided",
        ExpenseReportStatus.Cancelled => "el-status--cancelled",
        _ => "el-status--cancelled"
    };

    private static string StatusText(ExpenseReportStatus status) => status switch
    {
        ExpenseReportStatus.Draft => "草稿",
        ExpenseReportStatus.Submitted => "送審中",
        ExpenseReportStatus.Returned => "退回",
        ExpenseReportStatus.Approved => "已核准",
        ExpenseReportStatus.Rejected => "已拒絕",
        ExpenseReportStatus.Voided => "已作廢",
        ExpenseReportStatus.Cancelled => "已取消",
        _ => status.ToString()
    };

    private static string PaymentMethodText(ExpensePaymentMethod paymentMethod) => paymentMethod switch
    {
        ExpensePaymentMethod.EmployeePaid => "員工墊款",
        ExpensePaymentMethod.PersonalAdvance => "個人預支",
        ExpensePaymentMethod.PettyCash => "零用金支付",
        _ => paymentMethod.ToString()
    };

    private static string ExpenseTypeText(ExpenseType expenseType) => expenseType switch
    {
        ExpenseType.General => "一般支出",
        ExpenseType.Project => "專案支出",
        _ => expenseType.ToString()
    };

    private static string DisplayProjectName(ExpenseReportListItemDto report)
        => report.ExpenseType == ExpenseType.Project ? report.ProjectName ?? "(找不到專案)" : "-";

    private static bool HasFilter(ExpenseReportListPageDto page)
        => !string.IsNullOrWhiteSpace(page.Keyword) ||
           page.Status is not null ||
           page.ExpenseType is not null ||
           page.PaymentMethod is not null ||
           page.IncludeCancelled;

    private static string EmptyReportMessage(ExpenseReportListPageDto page)
        => page.TotalExpenseReportCount == 0
            ? "目前還沒有報銷單。"
            : "沒有符合篩選條件的報銷單。";
}
