@inject IConfiguration Config
@{
    var appName = Config["App:Name"] ?? "ExpenseLite";
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — @appName</title>
    <link rel="stylesheet" href="~/css/expenselite.css" asp-append-version="true" />
</head>
<body>
<div class="el-shell">
    <nav class="el-nav">
        <a class="el-nav-brand" asp-controller="Home" asp-action="Index">@appName</a>
        <a asp-controller="ExpenseReports" asp-action="Index" aria-current="@Current("ExpenseReports")">報銷單</a>
        <a asp-controller="CashAdvances" asp-action="Index" aria-current="@Current("CashAdvances")">預支款</a>
        <a asp-controller="Projects" asp-action="Index" aria-current="@Current("Projects")">專案</a>
        @if (User.IsManager())
        {
            <a asp-controller="Users" asp-action="Index" aria-current="@Current("Users")">使用者</a>
        }
        <partial name="_LoginPartial" />
    </nav>
    <div class="el-rule"></div>

    <main>
        @RenderBody()
    </main>
    <footer class="footer border-top mt-4 py-3 text-center">
        <span>© 2026 報銷系統</span>
        <span class="mx-2">·</span>
        <a asp-controller="Home" asp-action="Privacy">資料使用說明</a>
    </footer>
</div>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    // 讓目前所在的模組在功能列上變青色。aria-current 同時也是無障礙標記。
    private string? Current(string controller)
        => string.Equals(ViewContext.RouteData.Values["controller"] as string, controller, StringComparison.OrdinalIgnoreCase)
            ? "page" : null;
}
